# Offline mode needs no keys. Keep live disabled until separately authorized.
ART_ENABLE_LIVE=false
# No provider or model is chosen for you.
ART_MODEL_PROVIDER=
ART_MODEL_ID=
ART_MODEL_API=
ART_MODEL_BASE_URL=
ART_MODEL_API_KEY=
QLOO_API_KEY=
QLOO_API_URL=
# Fixed cap: 6 model + 6 Qloo HTTP attempts per project; 12 + 12 per process.
# Attempts include retries; automatic redirects are rejected.
PORT=3000
