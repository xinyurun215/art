# Import into the target art project's Preview environment only. Never import the local .env.
# Set Vercel's environment to Preview; VERCEL_ENV is provided by Vercel.
ART_ENABLE_LIVE=false
ART_MODEL_PROVIDER=deepseek
ART_MODEL_ID=deepseek-flash
ART_MODEL_API=openai-completions
ART_MODEL_BASE_URL=https://api.deepseek.com
ART_MODEL_API_KEY=
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
# Use a dedicated Neon pooled connection URL (TLS required), or authorized Postgres.
DATABASE_URL=
# Independent random secret. Browser username: preview; password: this key.
ART_PREVIEW_ACCESS_KEY=
# Per-project durable cap, including retries; changes apply to recorded usage, never reset it.
ART_MODEL_HTTP_LIMIT=6
ART_QLOO_HTTP_LIMIT=6
# Optional deployment-wide cap; leave unset for no shared limit.
# ART_SHARED_MODEL_HTTP_LIMIT=
# ART_SHARED_QLOO_HTTP_LIMIT=
