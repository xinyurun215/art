{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "functions": {
    "api/index.mjs": { "maxDuration": 300, "includeFiles": "fixtures/**" }
  },
  "routes": [
    { "src": "/", "dest": "/api/index" },
    { "src": "/index\\.html", "dest": "/api/index" },
    { "src": "/api(?:/.*)?", "dest": "/api/index" },
    { "handle": "filesystem" }
  ]
}
